# Copy this file to .env.dev and use only test Telegram credentials and chat IDs.
POSTGRES_DB=beneburg_dev
POSTGRES_USER=beneburg_dev
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://beneburg_dev:replace-with-local-password@postgres:5432/beneburg_dev?sslmode=disable

BOT_TOKEN=replace-with-test-bot-token
ADMIN_ID=123456789
GROUP_ID=-1001234567890
INVITE_LINK=https://t.me/example_test_group
DOMAIN=localhost
ENVIRONMENT=development
NO_AUTH=false
ONLY_MAKE_MIGRATIONS=false
TRUSTED_PROXY=

LOCAL_HTTP_PORT=8081
LOCAL_POSTGRES_PORT=5433
