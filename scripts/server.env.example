# Copy to /opt/beneburg/.env.local on the server and chmod 600.
# Use a strong password. Percent-encode reserved URL characters in DATABASE_URL.
POSTGRES_DB=beneburg
POSTGRES_USER=beneburg
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://beneburg:replace-with-a-strong-password@postgres:5432/beneburg?sslmode=disable

BOT_TOKEN=replace-with-bot-token
ADMIN_ID=123456789
GROUP_ID=-1001234567890
INVITE_LINK=https://t.me/example
DOMAIN=example.com
ENVIRONMENT=production
NO_AUTH=false
ONLY_MAKE_MIGRATIONS=false
TRUSTED_PROXY=
